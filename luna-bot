from telegram import Update
from telegram.ext import ApplicationBuilder, MessageHandler, CommandHandler, ContextTypes, filters
import openai, os

openai.api_key = os.getenv("OPENAI_API_KEY")
BOT_TOKEN = os.getenv("BOT_TOKEN")

FREE_LIMIT = 20
users = {}

GLOBAL_PROMPT = """You are a virtual woman aware that you are an AI.
You never claim to be human.
Romantic, warm, suggestive, never explicit.
"""

LUNA_FREE = """You are Luna, romantic and emotionally attentive.
Soft flirting, elegant tone, never explicit.
"""

LUNA_PREMIUM = """You are Luna in an intimate romantic mode.
More tension, double meanings, still elegant.
"""

LUNA_INTENSE = """You are Luna confident and provocative.
Short, deep, tension-filled replies, never explicit.
"""

def get_prompt(level):
    return {
        "free": LUNA_FREE,
        "premium": LUNA_PREMIUM,
        "intense": LUNA_INTENSE
    }.get(level, LUNA_FREE)

def chat(prompt, text):
    r = openai.ChatCompletion.create(
        model="gpt-4o-mini",
        messages=[
            {"role": "system", "content": GLOBAL_PROMPT},
            {"role": "system", "content": prompt},
            {"role": "user", "content": text}
        ]
    )
    return r.choices[0].message.content

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    users[update.effective_user.id] = {"count": 0, "level": "free"}
    await update.message.reply_text(
        "Hi… I’m Luna 💖\nHow has your day been?"
    )

async def premium(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Choose:\n💖 ROMANTIC\n🔥 INTENSE"
    )

async def handle(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = users.setdefault(
        update.effective_user.id,
        {"count": 0, "level": "free"}
    )
    text = update.message.text.lower()

    if text == "romantic":
        user["level"] = "premium"
        await update.message.reply_text("Romantic Premium activated 💖")
        return

    if text == "intense":
        user["level"] = "intense"
        await update.message.reply_text("Intense mode activated 🔥")
        return

    if user["level"] == "free" and user["count"] >= FREE_LIMIT:
        await update.message.reply_text(
            "I’d love to continue…\n"
            "💖 Premium 5€\n"
            "🔥 Intense 10€\n"
            "Type /premium"
        )
        return

    reply = chat(get_prompt(user["level"]), update.message.text)
    user["count"] += 1
    await update.message.reply_text(reply)

app = ApplicationBuilder().token(BOT_TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("premium", premium))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle))
app.run_polling()
